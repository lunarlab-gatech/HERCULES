<?xml version="1.0"?>
<!-- Husky-like skid-steer test robot: primitive, STL, OBJ and Collada
     visuals, wheels on continuous joints and Gazebo sensors. -->
<robot name="skid_robot">
  <material name="dark"><color rgba="0.2 0.2 0.2 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="0.99 0.67 0.25"/></geometry>
      <material name="dark"/>
    </visual>
    <visual name="top_plate">
      <origin xyz="0 0 0.135"/>
      <geometry>
        <mesh filename="package://test_robot_description/meshes/top_plate.stl" scale="1 1 1"/>
      </geometry>
      <material name="yellow"><color rgba="1 0.8 0 1"/></material>
    </visual>
    <visual name="front_bumper">
      <origin xyz="0.5 0 0" rpy="0 0 1.5707963267948966"/>
      <geometry><mesh filename="package://test_robot_description/meshes/bumper.dae"/></geometry>
      <material name="dark"/>
    </visual>
  </link>

  <link name="front_left_wheel">
    <visual>
      <origin rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.165" length="0.1143"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.256 0.2854 0.03282"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="front_right_wheel">
    <visual>
      <origin rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.165" length="0.1143"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.256 -0.2854 0.03282"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="rear_left_wheel">
    <visual>
      <origin rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.165" length="0.1143"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.256 0.2854 0.03282"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="rear_right_wheel">
    <visual>
      <origin rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.165" length="0.1143"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.256 -0.2854 0.03282"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="mast_link">
    <visual>
      <geometry><mesh filename="../meshes/mast.obj"/></geometry>
    </visual>
    <visual name="mirrored_mast">
      <geometry><mesh filename="../meshes/mast.obj" scale="1 -1 1"/></geometry>
    </visual>
    <visual name="antenna">
      <origin xyz="0 0 0.1"/>
      <geometry><mesh filename="package://test_robot_description/meshes/antenna.stl"/></geometry>
    </visual>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="-0.3 0 0.15"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.1 0 0.05"/>
  </joint>

  <link name="os_sensor">
    <visual>
      <geometry><cylinder radius="0.04" length="0.07"/></geometry>
    </visual>
  </link>
  <joint name="os_sensor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="os_sensor"/>
    <origin xyz="0.1 0 0.3"/>
  </joint>

  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.45 -0.1 0.2" rpy="0 0.2 -0.1"/>
  </joint>
  <link name="camera_link_optical"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor type="camera" name="front_cam">
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.5707963267948966</horizontal_fov>
        <image><width>1280</width><height>720</height></image>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="os_sensor">
    <sensor type="gpu_lidar" name="os1-64">
      <pose>0 0 0.036 0 0 0</pose>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal><samples>1024</samples><min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></horizontal>
          <vertical><samples>64</samples><min_angle>-0.39269908169872414</min_angle><max_angle>0.39269908169872414</max_angle></vertical>
        </scan>
        <range><min>0.5</min><max>120</max></range>
      </lidar>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor type="imu" name="imu"/>
  </gazebo>
  <gazebo reference="base_link">
    <sensor type="ray" name="sonar_front">
      <pose>0.5 0 0 0 0 0</pose>
      <ray>
        <scan><horizontal><samples>1</samples></horizontal></scan>
        <range><min>0.05</min><max>4</max></range>
      </ray>
    </sensor>
    <sensor type="contact" name="bumper_contact"/>
  </gazebo>
</robot>
