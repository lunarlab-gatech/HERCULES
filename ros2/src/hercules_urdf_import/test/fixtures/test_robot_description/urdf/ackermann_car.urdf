<?xml version="1.0"?>
<!-- Ackermann test car: steering knuckles on revolute joints (one mimics
     the other) and sensors declared only in the sensor config file. -->
<robot name="ackermann_car">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.3"/>
      <geometry><box size="4.2 1.8 0.8"/></geometry>
      <material name="paint"><color rgba="0.1 0.3 0.8 1"/></material>
    </visual>
  </link>

  <link name="front_left_knuckle"/>
  <joint name="front_left_steer" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_knuckle"/>
    <origin xyz="1.4 0.8 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="10" velocity="1"/>
  </joint>
  <link name="front_right_knuckle"/>
  <joint name="front_right_steer" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_knuckle"/>
    <origin xyz="1.4 -0.8 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="10" velocity="1"/>
    <mimic joint="front_left_steer" multiplier="1.0" offset="0"/>
  </joint>
  <link name="front_left_wheel">
    <visual>
      <origin rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.35" length="0.25"/></geometry>
    </visual>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_knuckle"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="front_right_wheel">
    <visual>
      <origin rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.35" length="0.25"/></geometry>
    </visual>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_knuckle"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="roof"/>
  <joint name="roof_joint" type="fixed">
    <parent link="base_link"/>
    <child link="roof"/>
    <origin xyz="0.2 0 1.2"/>
  </joint>
  <link name="zed_left_optical"/>
  <joint name="zed_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed_left_optical"/>
    <!-- optical convention (z forward), looking forward and 10 degrees down -->
    <origin xyz="1.0 0.06 1.0" rpy="-1.7453292519943295 0 -1.5707963267948966"/>
  </joint>
</robot>
