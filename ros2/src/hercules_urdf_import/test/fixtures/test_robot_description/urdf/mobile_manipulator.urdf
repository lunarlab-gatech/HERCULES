<?xml version="1.0"?>
<!-- Articulated test robot: a skid-steer base carrying an arm whose
     elbow range excludes zero, a mimic wrist and a prismatic gripper. -->
<robot name="mobile_manipulator">
  <link name="base_link">
    <visual><geometry><box size="0.8 0.5 0.3"/></geometry></visual>
  </link>
  <link name="shoulder_link">
    <visual><origin xyz="0 0 0.1"/><geometry><cylinder radius="0.05" length="0.2"/></geometry></visual>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="base_link"/><child link="shoulder_link"/>
    <origin xyz="0.2 0 0.15"/><axis xyz="0 0 1"/>
    <limit lower="-2" upper="2" effort="10" velocity="1"/>
  </joint>
  <link name="upper_arm">
    <visual><origin xyz="0 0 0.2"/><geometry><box size="0.06 0.06 0.4"/></geometry></visual>
  </link>
  <joint name="elbow" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm"/>
    <origin xyz="0 0 0.2"/><axis xyz="0 1 0"/>
    <limit lower="0.5" upper="2.5" effort="10" velocity="1"/>
  </joint>
  <link name="wrist_link">
    <visual><geometry><box size="0.05 0.05 0.05"/></geometry></visual>
  </link>
  <joint name="wrist" type="revolute">
    <parent link="upper_arm"/><child link="wrist_link"/>
    <origin xyz="0 0 0.4"/><axis xyz="0 1 0"/>
    <limit lower="-3" upper="3" effort="10" velocity="1"/>
    <mimic joint="elbow" multiplier="-1" offset="0.1"/>
  </joint>
  <link name="finger"/>
  <joint name="finger_joint" type="prismatic">
    <parent link="wrist_link"/><child link="finger"/>
    <origin xyz="0 0 0.05"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="0.04" effort="1" velocity="0.1"/>
  </joint>
  <gazebo reference="wrist_link">
    <sensor type="rgbd_camera" name="wrist_cam">
      <camera>
        <horizontal_fov>1.0</horizontal_fov>
        <image><width>424</width><height>240</height></image>
      </camera>
    </sensor>
  </gazebo>
</robot>
