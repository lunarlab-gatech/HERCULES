<!-- Go2 scene for the HERCULES bridge: menagerie go2.xml + a heightfield that the Unreal side fills in.
     The flat floor stays far below as a safety net; the hfield is the real ground. -->
<mujoco model="go2 hercules scene">
  <include file="MENAGERIE_GO2_XML"/>
  <option timestep="0.002"/>
  <asset>
    <hfield name="terrain" nrow="HF_N" ncol="HF_N" size="HF_HALF HF_HALF HF_ELEV 0.5"/>
  </asset>
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <!-- flat-floor fast path: on flat ground (window relief < 3 cm) the dog stands on this plane (4 clean foot
         contacts, the configuration the policy is reliable on) and the hfield is switched off; with relief the
         hfield takes over and the plane drops 20 m. Both on mocap bodies so they can be moved at runtime. -->
    <body name="floor_body" mocap="true" pos="0 0 0">
      <geom name="floor" type="plane" size="0 0 0.05" friction="0.8 0.02 0.01" priority="1" condim="3" rgba="0.3 0.3 0.3 1"/>
    </body>
    <!-- mocap body: a world geom's pos cannot be moved at runtime (MuJoCo keeps the compiled xpos), a mocap body can -->
    <body name="terrain_body" mocap="true" pos="0 0 0">
      <geom name="terrain" type="hfield" hfield="terrain" friction="0.8 0.02 0.01" priority="1" condim="3"/>
    </body>
  </worldbody>
  <sensor>
    <framequat name="imu_quat" objtype="site" objname="imu"/>
    <gyro name="imu_gyro" site="imu"/>
    <accelerometer name="imu_acc" site="imu"/>
    <framelinvel name="base_linvel" objtype="site" objname="imu"/>
  </sensor>
</mujoco>
